<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <Console name="SysOut" target="SYSTEM_OUT"><PatternLayout pattern="[%d{HH:mm:ss}] [%t/%level] [%logger]: %msg%n"/></Console>
    <File name="File" fileName="logs/latest.log"><PatternLayout pattern="[%d{HH:mm:ss}] [%t/%level]: %msg%n"/></File>
  </Appenders>
  <Loggers>
    <Logger name="net.minecraft.world.level.block.entity.TheEndGatewayBlockEntity" level="debug"/>
    <Root level="info"><AppenderRef ref="SysOut"/><AppenderRef ref="File"/></Root>
  </Loggers>
</Configuration>
